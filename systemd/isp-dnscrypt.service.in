[Unit]
Description=DNSCrypt client frontend for local BIND
Requires=@INSTANCE@-firewall.service
After=@INSTANCE@-firewall.service named.service
[Service]
User=@INSTANCE@
Group=@INSTANCE@
ExecStart=/opt/@INSTANCE@/encrypted-dns --config /etc/@INSTANCE@.toml
WorkingDirectory=/var/lib/@INSTANCE@
StateDirectory=@INSTANCE@
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
CPUQuota=100%
TasksMax=64

[Install]
WantedBy=multi-user.target
