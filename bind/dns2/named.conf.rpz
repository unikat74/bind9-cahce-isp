// dns2: secondary ThreatFox RPZ
include "/etc/bind/keys/threatfox-rpz-xfr.key";
include "/etc/bind/keys/hazard-rpz-xfr.key";

zone "rpz.threatfox.abuse.ch" {
    type secondary;
    allow-transfer { none; };
    file "/var/cache/bind/rpz/threatfox.rpz";
    primaries { DNS1_IPV4 key "threatfox-rpz-xfr"; };
    allow-notify { key "threatfox-rpz-xfr"; };
};

zone "rpz.hazard.mf.gov.pl" {
    type secondary;
    allow-transfer { none; };
    file "/var/cache/bind/rpz/hazard.rpz";
    primaries { DNS1_IPV4 key "hazard-rpz-xfr"; };
    allow-notify { key "hazard-rpz-xfr"; };
};
