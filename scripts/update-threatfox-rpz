#!/bin/sh
set -eu

. /etc/threatfox.env
: "${THREATFOX_AUTH_KEY:?Brak klucza w /etc/threatfox.env}"
: "${RELOAD:=yes}"

TARGET="/etc/bind/rpz/threatfox.rpz"
TMP="$(mktemp /etc/bind/rpz/threatfox.rpz.new.XXXXXX)"
URL="https://threatfox-api.abuse.ch/v2/files/exports/${THREATFOX_AUTH_KEY}/threatfox.rpz"
trap 'rm -f "$TMP"' EXIT

/usr/bin/curl --fail --silent --show-error --location "$URL" --output "$TMP"
grep -q 'SOA' "$TMP"
# ThreatFox QNAME triggers are relative to the RPZ origin. A valid domain
# can therefore exceed the DNS wire limit once the zone suffix is appended.
/usr/bin/python3 - "$TMP" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
origin = "rpz.threatfox.abuse.ch."
output = []
skipped = 0
for number, line in enumerate(path.read_text().splitlines(keepends=True), 1):
    fields = line.split()
    if fields and fields[0].upper() == "$ORIGIN":
        raise SystemExit("ThreatFox: unexpected $ORIGIN; preserving previous zone")
    # Only filter explicit QNAME NXDOMAIN records in the feed's plain format.
    # Other syntax/errors remain the responsibility of named-checkzone.
    if (line and not line[0].isspace() and len(fields) >= 3
            and fields[1].upper() == "CNAME" and fields[2] == "."
            and re.fullmatch(r"[A-Za-z0-9_*.-]+", fields[0])):
        owner = fields[0]
        absolute = owner if owner.endswith(".") else owner + "." + origin
        labels = absolute.rstrip(".").split(".")
        wire_length = 1 + sum(1 + len(label.encode("ascii")) for label in labels)
        if wire_length > 255 or any(len(label) > 63 for label in labels):
            print(f"WARNING ThreatFox: skipping overlong QNAME at line {number} "
                  f"(wire={wire_length} bytes, max-label={max(map(len, labels))})",
                  file=sys.stderr)
            skipped += 1
            continue
    output.append(line)
path.write_text("".join(output))
print(f"ThreatFox: skipped {skipped} overlong QNAME record(s)", file=sys.stderr)
PY
/usr/bin/named-checkzone rpz.threatfox.abuse.ch "$TMP"
chown root:bind "$TMP"
chmod 640 "$TMP"
mv "$TMP" "$TARGET"
if [ "$RELOAD" = yes ]; then
  /usr/sbin/rndc reload rpz.threatfox.abuse.ch
fi
