[DEFAULT]
backend = systemd
banaction = nftables-multiport

findtime = 10m
maxretry = 5
bantime = 1h

bantime.increment = true
bantime.factor = 2
bantime.maxtime = 7d

ignoreip = 127.0.0.1/8 ::1 198.51.100.144/32 203.0.113.190/32

[sshd]
enabled = true
port = ssh
filter = sshd
journalmatch = _SYSTEMD_UNIT=ssh.service + _COMM=sshd + _COMM=sshd-session


# Count IPv4 only; the separate IPv6 jail retains its own ban policy.
ignorecommand = /usr/bin/python3 -c "exit(':' not in '<ip>')"

[sshd-ip6]
enabled = true
backend = systemd
filter = sshd
port = 22
protocol = tcp
banaction = nftables-multiport-ip6[blocktype=drop]

findtime = 60m
maxretry = 5
bantime = 1d

bantime.increment = true
bantime.factor = 2
bantime.maxtime = 7d

# Inherit the administrative allowlist from DEFAULT.
ignorecommand = /usr/bin/python3 -c "exit(':' in '<ip>')"
